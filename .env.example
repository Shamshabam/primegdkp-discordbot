# Discord Developer Portal (discord.com/developers/applications)
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# Guild ID used by `npm run deploy-commands` for instant command registration during development
DISCORD_DEV_GUILD_ID=

# IANA timezone used as the default when creating recurring events, e.g. Europe/Copenhagen
DEFAULT_TIMEZONE=UTC

# Where signup/roster data is stored. "json" writes to ./data/store.json.
# Switch to "api" later to sync against the Prime GDKP website instead.
STORE_DRIVER=json

# Only used when STORE_DRIVER=api
PRIME_GDKP_API_URL=
PRIME_GDKP_INTERNAL_API_KEY=

# API server for website-to-bot communication
API_PORT=3001
